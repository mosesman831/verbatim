{
  "name": "@verbatim/memory-client",
  "version": "0.1.0",
  "description": "Thin zero-dependency TypeScript client for the Verbatim /v2/memory HTTP API",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "node -e \"import('./src/index.ts').then(() => console.log('memory-client loads'))\""
  },
  "keywords": [
    "verbatim",
    "memory",
    "agent",
    "mcp"
  ]
}
